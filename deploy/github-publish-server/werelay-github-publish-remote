#!/usr/bin/env bash
set -euo pipefail

umask 077
BASE_DIR="${WERELAY_GITHUB_PUBLISH_ROOT:-$HOME/werelay-github-relay}"
INCOMING_DIR="$BASE_DIR/incoming"
BARE_REPO="$BASE_DIR/repo.git"
WORK_ROOT="$BASE_DIR/work"
SSH_CONFIG="${WERELAY_GITHUB_SSH_CONFIG:-$HOME/.ssh/werelay_github_config}"
GITHUB_REPO="${WERELAY_GITHUB_REPOSITORY:-git@github.com:imsinolam/WeRelay.git}"
GITHUB_API_REPO="${WERELAY_GITHUB_API_REPOSITORY:-imsinolam/WeRelay}"
LOG_FILE="$BASE_DIR/push.log"
AUTHOR_NAME="${WERELAY_GITHUB_AUTHOR_NAME:-imsinolam}"
AUTHOR_EMAIL="${WERELAY_GITHUB_AUTHOR_EMAIL:-imsinolam@users.noreply.github.com}"
REQUIRED_CHECKS="${WERELAY_GITHUB_REQUIRED_CHECKS:-Secret scan|Quality (ubuntu-latest)|Quality (macos-latest)|Quality (windows-latest)}"
CHECK_TIMEOUT_SECONDS="${WERELAY_GITHUB_CHECK_TIMEOUT_SECONDS:-1200}"
CHECK_POLL_SECONDS="${WERELAY_GITHUB_CHECK_POLL_SECONDS:-30}"
WORK_DIR=""
REPOSITORY=""
ARCHIVE=""
REMOTE_CANDIDATE_REF=""

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [[ -n "$REMOTE_CANDIDATE_REF" && -d "$BARE_REPO" ]]; then
    git --git-dir="$BARE_REPO" push origin ":$REMOTE_CANDIDATE_REF" >/dev/null 2>&1 || true
  fi
  if [[ -n "$REPOSITORY" && -d "$REPOSITORY" && -d "$BARE_REPO" ]]; then
    git --git-dir="$BARE_REPO" worktree remove --force "$REPOSITORY" >/dev/null 2>&1 || true
  fi
  [[ -z "$WORK_DIR" ]] || rm -rf "$WORK_DIR"
  [[ -z "$ARCHIVE" ]] || rm -f "$ARCHIVE"
}
trap cleanup EXIT

wait_for_required_checks() {
  local commit="$1"
  local deadline=$((SECONDS + CHECK_TIMEOUT_SECONDS))
  local payload=""
  local check_state=""
  while (( SECONDS < deadline )); do
    payload="$(curl -fsSL \
      -H 'Accept: application/vnd.github+json' \
      -H 'X-GitHub-Api-Version: 2022-11-28' \
      "https://api.github.com/repos/$GITHUB_API_REPO/commits/$commit/check-runs?per_page=100")" \
      || fail "GitHub check-run query failed"
    check_state="$(printf '%s' "$payload" | node -e '
      let input = "";
      process.stdin.on("data", (chunk) => { input += chunk; });
      process.stdin.on("end", () => {
        const required = process.argv[1].split("|").filter(Boolean);
        const payload = JSON.parse(input);
        if (!Array.isArray(payload.check_runs)) {
          console.log(`FAIL ${payload.message || "invalid GitHub check-run response"}`);
          return;
        }
        const latest = new Map();
        for (const run of payload.check_runs) {
          if (!latest.has(run.name)) latest.set(run.name, run);
        }
        const pending = [];
        const failed = [];
        for (const name of required) {
          const run = latest.get(name);
          if (!run || run.status !== "completed") pending.push(name);
          else if (run.conclusion !== "success") failed.push(`${name}=${run.conclusion || "unknown"}`);
        }
        if (failed.length > 0) console.log(`FAIL ${failed.join(", ")}`);
        else if (pending.length > 0) console.log(`PENDING ${pending.join(", ")}`);
        else console.log("PASS");
      });
    ' "$REQUIRED_CHECKS")"
    case "$check_state" in
      PASS)
        printf 'CHECKS_PASSED %s\n' "$commit"
        return 0
        ;;
      FAIL*)
        fail "required GitHub checks failed: ${check_state#FAIL }"
        ;;
      PENDING*)
        printf 'CHECKS_WAITING %s\n' "${check_state#PENDING }"
        sleep "$CHECK_POLL_SECONDS"
        ;;
      *)
        fail "unexpected GitHub check state: $check_state"
        ;;
    esac
  done
  fail "timed out waiting for required GitHub checks"
}

[[ "$CHECK_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || fail "check timeout must be a positive integer"
[[ "$CHECK_POLL_SECONDS" =~ ^[1-9][0-9]*$ ]] || fail "check poll interval must be a positive integer"
[[ $# -eq 3 && "$2" == "--message-base64url" ]] || fail "usage: werelay-github-publish-remote <snapshot.tar.gz> --message-base64url <encoded-message>"
ARCHIVE="$1"
COMMIT_MESSAGE="$(node -e 'process.stdout.write(Buffer.from(process.argv[1], "base64url").toString("utf8"))' "$3")"
[[ -n "$COMMIT_MESSAGE" ]] || fail "commit message cannot be empty"
[[ "$COMMIT_MESSAGE" != *$'\n'* && "$COMMIT_MESSAGE" != *$'\r'* ]] || fail "commit message must be one line"
case "$ARCHIVE" in
  "$INCOMING_DIR"/werelay-snapshot-*.tar.gz) ;;
  *) fail "archive must be inside $INCOMING_DIR" ;;
esac
[[ -f "$ARCHIVE" ]] || fail "archive does not exist"
[[ ! -L "$ARCHIVE" ]] || fail "archive cannot be a symlink"

mkdir -p "$INCOMING_DIR" "$WORK_ROOT"
chmod 700 "$BASE_DIR" "$INCOMING_DIR" "$WORK_ROOT"
RELEASE_ID="$(basename "$ARCHIVE" .tar.gz)"
WORK_DIR="$WORK_ROOT/$RELEASE_ID"
mkdir -m 700 "$WORK_DIR"

tar -tzf "$ARCHIVE" >/dev/null
while IFS= read -r entry; do
  [[ -z "$entry" ]] && continue
  case "/$entry/" in
    *"/../"*|*"/.git/"*|*"/.DS_Store/"*) fail "archive contains a forbidden path: $entry" ;;
  esac
  base="${entry##*/}"
  [[ "$base" != ._* ]] || fail "archive contains AppleDouble metadata: $entry"
done < <(tar -tzf "$ARCHIVE")

SNAPSHOT="$WORK_DIR/snapshot"
mkdir -m 700 "$SNAPSHOT"
tar -xzf "$ARCHIVE" -C "$SNAPSHOT"

if [[ ! -d "$BARE_REPO" ]]; then
  git init --bare "$BARE_REPO" >/dev/null
  git --git-dir="$BARE_REPO" remote add origin "$GITHUB_REPO"
fi
CURRENT_ORIGIN="$(git --git-dir="$BARE_REPO" remote get-url origin 2>/dev/null || true)"
[[ "$CURRENT_ORIGIN" == "$GITHUB_REPO" ]] || fail "unexpected GitHub repository: $CURRENT_ORIGIN"

export GIT_SSH_COMMAND="ssh -F $SSH_CONFIG"
git --git-dir="$BARE_REPO" fetch --prune origin \
  '+refs/heads/main:refs/remotes/origin/main' >/dev/null
BASE_COMMIT="$(git --git-dir="$BARE_REPO" rev-parse refs/remotes/origin/main 2>/dev/null || true)"

REPOSITORY="$WORK_DIR/repository"
if [[ -n "$BASE_COMMIT" ]]; then
  git --git-dir="$BARE_REPO" worktree add --detach "$REPOSITORY" "$BASE_COMMIT" >/dev/null
else
  git --git-dir="$BARE_REPO" worktree add --detach "$REPOSITORY" >/dev/null
  git -C "$REPOSITORY" switch --orphan main >/dev/null
fi

rsync -a --delete --exclude='.git' --filter='protect .git' "$SNAPSHOT"/ "$REPOSITORY"/
find "$REPOSITORY" \( -name '.DS_Store' -o -name '._*' \) -print -quit | grep -q . && fail "working tree contains forbidden macOS metadata"
find "$REPOSITORY" -type f \( -name '*.pem' -o -name '*.key' -o -name '*.p12' -o -name '*.pfx' \) -print -quit | grep -q . && fail "working tree contains private key material"

(
  cd "$REPOSITORY"
  node scripts/check-public-safety.mjs
)
git -C "$REPOSITORY" config user.name "$AUTHOR_NAME"
git -C "$REPOSITORY" config user.email "$AUTHOR_EMAIL"
git -C "$REPOSITORY" add --all

if git -C "$REPOSITORY" diff --cached --quiet; then
  COMMIT="$(git -C "$REPOSITORY" rev-parse HEAD)"
  printf 'NO_CHANGES %s\n' "$COMMIT"
else
  git -C "$REPOSITORY" commit -m "$COMMIT_MESSAGE" >/dev/null
  COMMIT="$(git -C "$REPOSITORY" rev-parse HEAD)"
  if [[ -n "$BASE_COMMIT" ]]; then
    git --git-dir="$BARE_REPO" merge-base --is-ancestor "$BASE_COMMIT" "$COMMIT" \
      || fail "candidate commit is not a fast-forward of GitHub main"
  fi

  REMOTE_CANDIDATE_REF="refs/heads/werelay-release-candidate/${RELEASE_ID#werelay-snapshot-}"
  git --git-dir="$BARE_REPO" push origin "$COMMIT:$REMOTE_CANDIDATE_REF" >/dev/null
  wait_for_required_checks "$COMMIT"

  CURRENT_REMOTE_MAIN="$(git --git-dir="$BARE_REPO" ls-remote origin refs/heads/main | awk 'NR == 1 { print $1 }')"
  [[ "$CURRENT_REMOTE_MAIN" == "$BASE_COMMIT" ]] \
    || fail "GitHub main changed while candidate checks were running"
  git --git-dir="$BARE_REPO" push origin "$COMMIT:refs/heads/main" >/dev/null
  git --git-dir="$BARE_REPO" update-ref refs/heads/main "$COMMIT"
fi

REMOTE_COMMIT="$(git --git-dir="$BARE_REPO" ls-remote origin refs/heads/main | awk 'NR == 1 { print $1 }')"
[[ "$REMOTE_COMMIT" == "$COMMIT" ]] || fail "GitHub verification returned a different commit"
printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$COMMIT" "$GITHUB_REPO" "$COMMIT_MESSAGE" >> "$LOG_FILE"
chmod 600 "$LOG_FILE"
printf 'PUSHED %s\n' "$COMMIT"
