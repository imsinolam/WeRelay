# WeRelay configuration reference. This file is not loaded automatically.
# Export variables in the shell or add them to your process supervisor.

# Runtime data remains local. Never point this at a directory inside the repository.
# WERELAY_DATA_DIR=$HOME/.werelay
# WERELAY_LANG=zh

# Mobile web port on the computer running WeRelay.
WERELAY_MOBILE_PORT=4396

# Leave unset for LAN-only web mode. When configured, the Mac actively connects
# to the application relay; no local port is exposed or reverse-tunnelled.
# WERELAY_RELAY_URL=https://relay.example.com
# WERELAY_RELAY_TRANSPORT=auto # Prefer WSS, fall back to HTTPS; long-poll forces the old channel.
# WERELAY_RELAY_DEVICE_ID=my-mac
# WERELAY_RELAY_DEVICE_TOKEN=replace-with-a-long-random-token

# Advanced: an explicit public web base URL managed by your own approved gateway.
# Normal internet deployment should use WERELAY_RELAY_URL instead.
# WERELAY_MOBILE_PUBLIC_URL=https://mobile.example.com

# Public relay server environment (configure on the server, not the Mac daemon).
# WERELAY_RELAY_HOST=127.0.0.1
# WERELAY_RELAY_PORT=14396
# WERELAY_RELAY_DEVICE_ID=my-mac
# WERELAY_RELAY_DEVICE_TOKEN=replace-with-the-same-random-token
# WERELAY_RELAY_TASK_LINK_STATE_FILE=/var/lib/werelay/relay-task-links.json

# Optional upload limits.
# WECHAT_MAX_IMAGE_MB=20
# WECHAT_MAX_FILE_MB=50
# WECHAT_MAX_VOICE_MB=20
# WECHAT_MAX_VIDEO_MB=100

# Optional DeepSeek Harness host override. Leave unset to auto-discover a
# running DSH Desktop or dsh web host on this computer. Loopback URLs only.
# WERELAY_DEEPSEEK_HARNESS_URL=http://127.0.0.1:3080

# Optional runtime behavior.
# WERELAY_STRICT_APPROVAL=1
# WERELAY_THINKING_FORWARD=1
# WERELAY_REASONIX_OPEN_WEB=0
